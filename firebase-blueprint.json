{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Synapse CFO OS",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "viewer", "editor"] },
        "orgId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "orgId"]
    },
    "Organization": {
      "title": "Organization",
      "description": "A company or organization using Synapse",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "currency": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction (inflow or outflow)",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "type": { "type": "string", "enum": ["inflow", "outflow"] },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "vendor": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "description": { "type": "string" }
      },
      "required": ["orgId", "type", "amount", "timestamp"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "An accounts receivable or payable invoice",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "type": { "type": "string", "enum": ["payable", "receivable"] },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "format": "date-time" },
        "vendor": { "type": "string" },
        "status": { "type": "string", "enum": ["unpaid", "paid", "overdue"] },
        "riskScore": { "type": "number" },
        "predictedPayDate": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "type", "amount", "dueDate"]
    },
    "Alert": {
      "title": "Alert",
      "description": "System generated financial alert or anomaly",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["anomaly", "warning", "info"] },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "title", "timestamp"]
    },
    "Forecast": {
      "title": "Forecast",
      "description": "BudgetBrain rolling forecasts and scenarios",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "name": { "type": "string" },
        "scenario": { "type": "string" },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "name"]
    },
    "VendorContract": {
      "title": "Vendor Contract",
      "description": "VendorIQ contract data",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "vendorName": { "type": "string" },
        "renewalDate": { "type": "string", "format": "date-time" },
        "annualSpend": { "type": "number" },
        "score": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["orgId", "vendorName"]
    },
    "Investment": {
      "title": "Investment",
      "description": "InvestIQ yield optimization data",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "instrument": { "type": "string" },
        "amount": { "type": "number" },
        "yield": { "type": "number" },
        "maturityDate": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "instrument", "amount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Organization data"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices"
    },
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "System alerts"
    },
    "/forecasts/{forecastId}": {
      "schema": "Forecast",
      "description": "BudgetBrain forecasts"
    },
    "/vendor_contracts/{contractId}": {
      "schema": "VendorContract",
      "description": "Vendor contracts"
    },
    "/investments/{investmentId}": {
      "schema": "Investment",
      "description": "Investments"
    }
  }
}
